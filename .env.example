# ---------------------------------------------------------------- Gemini
# The proposer. GOOGLE_API_KEY is accepted as an alias.
GEMINI_API_KEY=

# ---------------------------------------------------------------- Telegram
# A SEPARATE bot from the executor's control bot. Two processes long-polling getUpdates on
# one token fight over every update, so reusing TELEGRAM_BOT_TOKEN here would silently
# break /status and /kill on the executor. Create one with @BotFather, add it to the group.
AGENTIC_BOT_TOKEN=
AGENTIC_CHAT_ID=                 # defaults to TELEGRAM_CHAT_ID if unset
AGENTIC_THREAD=                  # topic id, or "here", or blank for the main thread
AGENTIC_ALLOWED_USER_IDS=        # REQUIRED — comma-separated. Empty means nobody can trade.

# ---------------------------------------------------------------- executor
EXECUTOR_URL=http://127.0.0.1:8000
EXECUTOR_API_KEY=
AGENTIC_STRATEGY_ID=agentic_macro   # must exist in the executor's CONFIG (/addstrategy)

# PAPER MODE — the executor is never contacted and no order is placed. Everything else
# works: proposals, both approval gates, the stored worldviews and the order previews.
# Set this while the executor is not connected; unset it to trade for real.
AGENTIC_PAPER=false
AGENTIC_PAPER_CAPITAL=250000

# ---------------------------------------------------------------- optional knobs
# AGENTIC_MODEL=gemini-3.5-flash
# AGENTIC_THINKING_LEVEL=high            # gemini 3.x reasoning depth: low | high
# AGENTIC_FALLBACK_MODELS=gemini-3.1-pro-preview,gemini-3.8-flash,gemini-3-flash-preview
# AGENTIC_EFFORT=high
# AGENTIC_MAX_WORLDVIEW_WEIGHT=0.35   # most of the sleeve one view may take
# AGENTIC_MAX_GROSS_WEIGHT=0.95       # most of the allocation all views may take
# AGENTIC_MAX_PRICE_DRIFT=0.02        # refuse an approval whose legs moved more than this
# AGENTIC_MAX_LEGS=6
# AGENTIC_FRACTIONAL=true             # fractional ETF sizing; futures are always whole
# AGENTIC_FRACTIONAL_DP=4
# AGENTIC_VOL_LOOKBACK=60             # trading days of realised vol for inverse-vol sizing
# AGENTIC_CONFIRM_TTL=900
# AGENTIC_DB_PATH=db/worldviews.db
